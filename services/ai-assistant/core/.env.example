# AWS credentials — use IAM role in production, env vars for local dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_PROFILE=regal-federated

# Bedrock model ID — Claude 3.5 Haiku (fast, cost-effective)
# Other options:
#   anthropic.claude-3-5-sonnet-20241022-v2:0  (smarter)
#   anthropic.claude-opus-4-5-20251101-v1:0    (most capable)
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8200

# Internal port for the FastAPI core
PORT=9000
