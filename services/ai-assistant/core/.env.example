# AWS — use a named profile from ~/.aws
AWS_PROFILE=<your-aws-profile>
AWS_REGION=us-west-2

# Bedrock model ID — Claude 3.5 Haiku (fast, cost-effective)
# Other options:
#   us.anthropic.claude-haiku-4-5-20251001-v1:0  (smarter)
#   anthropic.claude-opus-4-5-20251101-v1:0    (most capable)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8200

# Internal port for the FastAPI core
PORT=19010
