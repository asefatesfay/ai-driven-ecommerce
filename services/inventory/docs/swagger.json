{
    "swagger": "2.0",
    "info": {
        "description": "Product inventory management and sync",
        "title": "Inventory Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/api/v1",
    "paths": {
        "/inventory": {
            "get": {
                "description": "Get inventory for multiple products using a comma-separated list of style IDs",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Bulk get inventory by style IDs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Comma-separated style IDs",
                        "name": "style_ids",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/definitions/models.ProductInventory"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    }
                }
            }
        },
        "/inventory/adjust": {
            "post": {
                "description": "Apply a delta (positive=restock, negative=sold/reserve) to a product variant",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Adjust inventory",
                "parameters": [
                    {
                        "description": "Inventory adjustment",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.InventoryAdjustment"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ProductInventory"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    }
                }
            }
        },
        "/inventory/sync": {
            "post": {
                "description": "Trigger the editorial active-flag sync based on current stock levels",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Sync inventory",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    }
                }
            }
        },
        "/inventory/{productId}": {
            "get": {
                "description": "Get inventory variants for a product by its numeric product ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "inventory"
                ],
                "summary": "Get product inventory",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Product ID",
                        "name": "productId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ProductInventory"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/middleware.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "middleware.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "models.InventoryAdjustment": {
            "type": "object",
            "properties": {
                "color_name": {
                    "type": "string"
                },
                "delta": {
                    "description": "positive = restock, negative = sold/reserve",
                    "type": "integer"
                },
                "product_id": {
                    "type": "integer"
                },
                "reason": {
                    "type": "string"
                },
                "size": {
                    "type": "string"
                },
                "style_id": {
                    "type": "string"
                }
            }
        },
        "models.InventoryEntry": {
            "type": "object",
            "properties": {
                "available_qty": {
                    "type": "integer"
                },
                "color_name": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "last_synced_at": {
                    "type": "string"
                },
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "reserved_qty": {
                    "type": "integer"
                },
                "size": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/models.InventoryStatus"
                },
                "style_id": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.InventoryStatus": {
            "type": "string",
            "enum": [
                "in_stock",
                "low_stock",
                "out_of_stock"
            ],
            "x-enum-varnames": [
                "StatusInStock",
                "StatusLowStock",
                "StatusOutOfStock"
            ]
        },
        "models.ProductInventory": {
            "type": "object",
            "properties": {
                "in_stock": {
                    "description": "true if ANY variant has qty \u003e 0",
                    "type": "boolean"
                },
                "product_id": {
                    "type": "integer"
                },
                "style_id": {
                    "type": "string"
                },
                "variants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.InventoryEntry"
                    }
                }
            }
        }
    }
}